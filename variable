class Variable:
    def __init__(self, v, lower, upper):
        self.unconstrained = inverse(v, lower, upper)
        # TODO: make sure unconstrained requires grad
        self.lower = lower
        self.upper = upper
        
    def get_unconstrained(self):
        return self.unconstrained
        
    def get_value(self):
        return constrain(self.unconstrained, self.lower, self.upper)
